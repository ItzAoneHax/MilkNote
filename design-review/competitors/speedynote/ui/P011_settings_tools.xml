ode index="4" text="" resource-id="QApplication.ControlPanelDialog.QTabWidget.qt_tabwidget_stackedwidget.QWidget.QGroupBox.QLabel" class="android.widget.TextView" package="org.speedynote.app" content-desc="让你只用手写笔就能平移视图，无需按住按键或切换到抓手工具。绘图工具不受影响，因为它们只在页面内生效。在空白区域点击一下仍然会取消当前选择；从页面上开始的拖动始终按绘图处理。此选项不适用于无边画布。" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[50,356][2509,387]" /></node><node index="1" text="" resource-id="QApplication.ControlPanelDialog.QTabWidget.qt_tabwidget_stackedwidget.QWidget.QGroupBox" class="android.view.ViewGroup" package="org.speedynote.app" content-desc="OCR (手写识别)" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,414][2527,617]"><node index="0" text="" resource-id="QApplication.ControlPanelDialog.QTabWidget.qt_tabwidget_stackedwidget.QWidget.QGroupBox.QCheckBox" class="android.widget.CompoundButton" package="org.speedynote.app" content-desc="中日韩文的逐块识别模式 (遵循网格线的边界逐字识别)" checkable="true" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[50,476][751,527]" /><node index="1" text="" resource-id="QApplication.ControlPanelDialog.QTabWidget.qt_tabwidget_stackedwidget.QWidget.QGroupBox.QLabel" class="android.widget.TextView" package="org.speedynote.app" content-desc="当“OCR边界设为条格线”选项在OCR子工具栏中开启后，以及背景设置为了网格，这个选项让每一个格子识别一个中文/日文/韩文的方块字。相邻的字符依然会被融合为一个句子。关闭这个选项会回归按行识别（适用于大多数其它语言）。这是未经当前文档设置 - OCR 覆盖的默认选项。" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[50,536][2509,599]" /></node></node></node><node index="1" text="" resource-id="QAppli